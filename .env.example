# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/issuelens

# GitHub App credentials
# Optional during local development; raises the public GitHub API rate limit
GITHUB_TOKEN=
GITHUB_APP_ID=
# Use either an inline key or a local key-file path
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
